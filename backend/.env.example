PORT=3000
HOST=127.0.0.1

# SQLite: ruta relativa a la carpeta del proyecto o ruta absoluta.
# Por defecto se crea database/atlantic_crm.db automáticamente.
SQLITE_FILE=./database/atlantic_crm.db

# Genera secretos largos y únicos antes de usar en producción.
JWT_SECRET=REEMPLAZA_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:3000
INTEGRATION_WEBHOOK_SECRET=REEMPLAZA_POR_OTRO_SECRETO_ALEATORIO
